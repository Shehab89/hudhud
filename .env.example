# Copy to .env and fill in. Never commit .env. Nothing here is ever sent to the browser
# except variables prefixed NEXT_PUBLIC_, which must never hold secrets.

# --- Database (PostgreSQL 16 with the pgvector extension)
POSTGRES_USER=observatory
POSTGRES_PASSWORD=change-me
POSTGRES_DB=observatory
DATABASE_URL=postgresql+psycopg://observatory:change-me@localhost:5432/observatory
# Only for the test suite; the database is WIPED by the tests.
TEST_DATABASE_URL=postgresql+psycopg://observatory:change-me@localhost:5432/observatory_test

# --- NLP
# auto = transformer models when installed, else the deterministic fallback (recorded per result)
NLP_BACKEND=auto
EMBEDDING_MODEL=intfloat/multilingual-e5-small
SENTIMENT_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment-multilingual
SENTIMENT_MODEL_AR=CAMeL-Lab/bert-base-arabic-camelbert-mix-sentiment
ZERO_SHOT_MODEL=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7
ACCEPT_THRESHOLD=0.85
SECONDARY_THRESHOLD=0.60
# Docker builds with transformer models when true (large image); false = fallback NLP only
INSTALL_ML=false

# --- Optional LLM tier (low-confidence items only, with a hard daily budget)
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5
LLM_DAILY_BUDGET_USD=1.0
LLM_MAX_ARTICLES_PER_RUN=50

# --- Fetching
# Set a contact URL or address so publishers can reach the operator.
USER_AGENT=YemenMediaObservatoryBot/0.1 (+https://example.org/about; research crawler; respects robots.txt)
LOOKBACK_DAYS=3
FETCH_CONCURRENCY=8

# --- API
API_CORS_ORIGINS=http://localhost:3000
API_RATE_LIMIT=120/minute
# Long random string; the admin API is disabled while this is empty.
ADMIN_TOKEN=
LOG_LEVEL=INFO
LOG_JSON=false

# --- Frontend
# Browser-visible API base URL (public, no secrets)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-side API URL when it differs from the public one (e.g. inside docker compose)
API_URL=
